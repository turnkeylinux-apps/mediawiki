#!/bin/bash -eux

dl() {
    local proxy_args=()
    local filename=${1##*/}
    local partial="${filename}.part"
    local attempt
    [ -n "${FAB_HTTP_PROXY:-}" ] && proxy_args=(--proxy "$FAB_HTTP_PROXY")
    cd "$2"
    # Wikimedia's CDN may cancel long-lived HTTP/2 transfers. Keep the
    # integrity check below authoritative and resume bounded HTTP/1.1 attempts
    # rather than discarding each partial release archive.
    for attempt in $(seq 1 10); do
        if curl --proto '=https' --tlsv1.2 --http1.1 -L -f \
                --connect-timeout 30 --max-time 180 --continue-at - \
                --output "$partial" "${proxy_args[@]}" "$1"; then
            mv "$partial" "$filename"
            cd -
            return
        fi
        sleep 2
    done
    cd -
    return 1
}

VERSION=1.46.0
SERIES=1.46
SHA256=ac395e4ffd3b63b86a242efd679257503e463445ba9f989b514d9d3b342c456a
URL=https://releases.wikimedia.org/mediawiki/${SERIES}/mediawiki-${VERSION}.tar.gz

dl "$URL" /usr/local/src
echo "$SHA256  /usr/local/src/mediawiki-${VERSION}.tar.gz" \
    | sha256sum --check --strict
